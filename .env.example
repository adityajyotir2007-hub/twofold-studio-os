# =============================================================================
# TWOFOLD STUDIO OS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.local and fill in credentials for live external integrations.
# Never commit .env.local or secret keys to version control.
# =============================================================================

# 1. Primary Database, Auth, Realtime & File Storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=agency-documents

# 2. Server Security & Token Encryption Vault (AES-256-GCM & Session Signing)
SESSION_SECRET=replace-with-32-byte-random-hex-session-secret
ENCRYPTION_SECRET=replace-with-32-byte-random-hex-vault-key
WEBHOOK_VERIFY_TOKEN=twofold_webhook_verify_2026

# 3. Google OAuth 2.0 (Gmail API, Google Sheets API, Google Calendar API)
# Authorized Redirect URI: https://<your-domain>/api/integrations/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Meta Graph API (WhatsApp Business Cloud API & Instagram Professional API)
# Authorized Redirect URI: https://<your-domain>/api/integrations/oauth/callback
# Webhook Callback URL:    https://<your-domain>/api/webhooks/whatsapp (and /api/webhooks/instagram)
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# 5. Calling Provider (Twilio Voice / Status Callback Webhook)
# Webhook Callback URL:    https://<your-domain>/api/webhooks/calling
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. App Defaults
NEXT_PUBLIC_APP_NAME="Twofold Studio OS"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
